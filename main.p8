pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
#include sprite.lua
#include police.lua
#include level.lua
#include physics.lua
#include screen.lua

--initialize position, sprite frame, and timer --
function _init()
	palt(2, true)
	palt(0, false)
	music(0)
	level_num = 0
	sprites = {}
end

--update positions and sprite frames --
function _update()
	if level_num == 0 then
		cleared = update_start_screen()
		if cleared then 
			level_num += 1
			sprites = init_level(level_num)
		end
	end

	if 0 < level_num and level_num <= 3 then
		update_level(sprites)
		if level_cleared(sprites) then
			level_num += 1
			if level_num <= 3 then
				sprites = init_level(level_num)
			end
		end
	end

	if level_num > 3 then
		restart = update_end_screen()
		if restart then 
			level_num = 1
			sprites = init_level(level_num)
		end
	end
end

-- draw the sprite at the new position --
function _draw()
	cls()

	if level_num == 0 then
		draw_start_screen()
	end

	if level_num > 0 and level_num <= 3 then 
		map(sprites["map_x"], 0, 0, 0, 16, 14)
		draw_level(sprites, level_num)
	end

	if level_num > 3 then
		draw_end_screen()
	end

end

